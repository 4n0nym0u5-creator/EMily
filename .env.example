# Copy this file to .env and restart `npm run dev`.
# The key stays on the computer that runs the app. It is not sent to the browser.
#
# Get a key at https://venice.ai/settings/api
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Text-only pictures (backgrounds with no photo) use POST /image/generate.
VENICE_IMAGE_MODEL=wai-Illustrious

# Photos and drawings used as a reference use POST /image/edit.
# wai-Illustrious cannot take a reference image.
VENICE_EDIT_MODEL=firered-image-edit

# See-through characters then call POST /image/background-remove with this same key.
# That request has no model id and no safe_mode. The switch is in the app.

# Used by `npm run venice:check` (a short text greeting, not a picture).
VENICE_TEXT_MODEL=z-ai-glm-5-3-flash

# Picture safe mode. false is the default and sends safe_mode:false on every image call.
# Set to true to let Venice blur results it considers adult. A blurred or violating
# picture is never shown. Restart `npm run dev` after changing this.
VENICE_SAFE_MODE=false

# Developer only: pretend AI is on without calling Venice or spending money.
# EMILY_MOCK_AI=1
