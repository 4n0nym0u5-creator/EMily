# Copy this file to .env and restart `npm run dev`.
# The key stays on the computer that runs the app. It is not sent to the browser.
#
# Get a key at https://platform.openai.com/api-keys
# Image generation uses gpt-image-1 and costs money. See the README.
OPENAI_API_KEY=

# low spends less. medium is the default. high costs more.
# OPENAI_IMAGE_QUALITY=medium

# Developer only: pretend AI is on without calling OpenAI or spending money.
# EMILY_MOCK_AI=1
